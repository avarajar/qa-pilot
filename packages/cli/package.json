{
  "name": "qa-pilot",
  "version": "0.1.0",
  "description": "QA automático con router de riesgo: el humano solo interviene en lo crítico",
  "type": "module",
  "license": "MIT",
  "bin": {
    "qa-pilot": "./bin/qa-pilot.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p schema && cp ../../spec/qa-pilot.schema.json schema/",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.11.2",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
